{
  "name": "playwright-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Playwright Agent: requirement-guided test authoring, acceptance assessment and behavioral mutation verification.",
  "type": "module",
  "scripts": {
    "source:manifest": "node scripts/sync-source-manifest.mjs --write",
    "source:manifest:check": "node scripts/sync-source-manifest.mjs --check",
    "source:manifest:crm": "node scripts/sync-source-manifest.mjs --write --adapter=sample-crm --output=examples/sample-crm-app/source-manifest.json",
    "source:manifest:crm:check": "node scripts/sync-source-manifest.mjs --check --adapter=sample-crm --output=examples/sample-crm-app/source-manifest.json",
    "test": "npm run source:manifest:crm -- --quiet && npx playwright test",
    "test:smoke": "npm run source:manifest:crm -- --quiet && npx playwright test --grep @smoke",
    "test:headed": "npm run source:manifest:crm -- --quiet && npx playwright test --headed --project=chromium",
    "test:debug": "npm run source:manifest:crm -- --quiet && npx playwright test --debug --project=chromium",
    "test:ui": "npm run source:manifest:crm -- --quiet && npx playwright test --ui",
    "test:auth": "npm run source:manifest:crm -- --quiet && npx playwright test tests/auth.setup.ts --project=setup",
    "sample:crm": "node examples/sample-crm-app/server.mjs",
    "sample:crm:test": "npm run source:manifest:crm -- --quiet && npx playwright test tests/sample-crm.spec.ts --project=chromium",
    "capture:recipes:generate": "npm run source:manifest:crm -- --quiet && node scripts/generate-capture-recipes.mjs --write",
    "capture:recipe": "node scripts/run-capture-recipe.mjs",
    "capture:crm:admin": "node scripts/run-capture-recipe.mjs crm-admin-role",
    "capture:crm:manager": "node scripts/run-capture-recipe.mjs crm-manager-role",
    "capture:crm:sales": "node scripts/run-capture-recipe.mjs crm-sales-role",
    "capture:crm:viewer": "node scripts/run-capture-recipe.mjs crm-viewer-role",
    "graph:source": "npm run source:manifest:crm -- --quiet && node scripts/graph-source.mjs",
    "graph:tests": "node scripts/graph-tests.mjs",
    "graph:coverage": "node scripts/graph-coverage.mjs",
    "graph:duplicates": "node scripts/graph-duplicates.mjs",
    "graph:view": "npm run source:manifest:crm -- --quiet && node scripts/graph-view.mjs",
    "graph:serve": "npm run source:manifest:crm -- --quiet && node scripts/graph-view.mjs --serve",
    "show:report": "npx playwright show-report",
    "show:trace": "npx playwright show-trace",
    "typecheck": "tsc --noEmit",
    "benchmark:collect": "node benchmarks/trials.mjs collect",
    "benchmark:summary": "node benchmarks/trials.mjs summary",
    "benchmark:test": "node --test benchmarks/*.test.mjs",
    "benchmark:oracle": "npm run benchmark",
    "benchmark:mutation": "npm run benchmark",
    "benchmark": "python3 benchmarks/dashboard/run.py",
    "benchmark:publish": "python3 benchmarks/dashboard/publish.py",
    "postbenchmark:collect": "python3 benchmarks/dashboard/publish.py --refresh-trials",
    "benchmark:trials": "python3 benchmarks/controlled-trials.py",
    "security:staged": "node scripts/security-gate.mjs",
    "security:hooks": "node scripts/install-security-hook.mjs",
    "security:check": "python3 scripts/security_audit.py",
    "qa": "node scripts/run-quality.mjs qa",
    "mutation": "node scripts/run-quality.mjs mutation",
    "quality:typecheck": "npm --prefix quality run typecheck",
    "quality:test": "npm --prefix quality test && node --test scripts/run-quality.test.mjs",
    "quality:context": "npm --prefix quality run context:resolve",
    "quality:preview": "npm --prefix quality run review:preview",
    "quality:code-mode": "node scripts/run-quality.mjs code-mode",
    "quality:export": "node scripts/run-quality.mjs export",
    "demo:prepare": "node scripts/run-quality.mjs demo prepare",
    "demo:verify": "node scripts/run-quality.mjs demo verify",
    "demo:package": "python3 scripts/package-demo.py",
    "demo:test": "node --test scripts/package-demo.test.mjs scripts/validation-graphs.test.mjs",
    "agent:configure": "node scripts/configure-agent.mjs",
    "agent:test": "node --test scripts/configure-agent.test.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "^22.0.0",
    "typescript": "^7.0.2",
    "yaml": "^2.9.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/balajiregt/playwright-agent.git"
  },
  "license": "MIT"
}
