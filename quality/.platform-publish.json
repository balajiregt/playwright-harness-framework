{
  "schemaVersion": 1,
  "publisherVersion": "1.0.0",
  "projectId": "agentic-playwright",
  "repository": "https://github.com/balajiregt/playwright-agent",
  "branch": "platform-results",
  "feedPath": "metrics.json",
  "scope": "synthetic",
  "methodologyUrl": "https://github.com/balajiregt/playwright-agent/blob/main/quality/docs/independent-mutation-analysis.md",
  "limitations": [
    "Authored role-aware demo requirements and selected behavioral faults; this is not customer or production coverage.",
    "Laya and Codex use identical frozen packets through Code Mode; workflow and context-window overhead differ.",
    "Prediction agreement is checked against observed assertions, not independent reviewed requirement-coverage labels.",
    "Unknown, unactivated and unstable executions are not detection successes; model uncertainty remains visible.",
    "Codex uses its CLI default unless configured; its resolved model name may be unavailable.",
    "Reported tokens cover completed responses; failed requests can have unreported usage. Probabilities are uncalibrated.",
    "Actual billed API cost, local energy and human review effort are unmeasured. Source revision is unknown for this imported checkout."
  ],
